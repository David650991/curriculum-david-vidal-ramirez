<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#0f3b60">
<title>{{ profile.SITE.name }}</title>
<meta name="description" content="{{ profile.SITE.description }}">
<meta name="author" content="{{ profile.USER.name }}">
<meta name="creator" content="{{ profile.SITE.creator }}">
<meta name="copyright" content="{{ profile.SITE.copyright }}">
<meta name="robots" content="index, follow, max-image-preview:large">
<link rel="canonical" href="{{ profile.SITE.url }}/">
<meta property="og:locale" content="es_MX">
<meta property="og:type" content="profile">
<meta property="og:url" content="{{ profile.SITE.url }}/">
<meta property="og:title" content="{{ profile.SITE.name }}">
<meta property="og:description" content="{{ profile.SITE.description }}">
<meta property="og:image" content="{{ profile.SITE.url }}/{{ profile.USER.avatar }}">
<meta property="og:image:alt" content="Retrato profesional de {{ profile.USER.name }}">
<meta property="profile:first_name" content="David">
<meta property="profile:last_name" content="Vidal Ramírez">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ profile.SITE.name }}">
<meta name="twitter:description" content="{{ profile.SITE.description }}">
<meta name="twitter:image" content="{{ profile.SITE.url }}/{{ profile.USER.avatar }}">
<script type="application/ld+json">
{{ {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": profile.USER.name,
  "url": profile.SITE.url,
  "image": profile.SITE.url ~ "/" ~ profile.USER.avatar,
  "jobTitle": "Desarrollador de software",
  "description": profile.SITE.description,
  "email": "mailto:" ~ profile.USER.email,
  "address": {"@type": "PostalAddress", "addressLocality": "Tres Valles", "addressRegion": "Veracruz", "addressCountry": "MX"},
  "sameAs": profile.SOCIAL | map(attribute="url") | list,
  "affiliation": {"@type": "CollegeOrUniversity", "name": "Instituto Tecnológico de Tuxtepec · Tecnológico Nacional de México"},
  "knowsAbout": ["Python", "JavaScript", "Flask", "Node.js", "Cloudflare", "aplicaciones web", "automatización de procesos", "visión computacional", "sistemas en tiempo real"]
} | json | safe }}
</script>
