<section id="contacto" class="section contact-section section-anchor">
  <div class="container contact-grid">
    <div><p class="eyebrow">{{ contact.HEADER.eyebrow }}</p><h2>{{ contact.HEADER.title }}</h2><p>{{ contact.HEADER.description }}</p><a class="location" href="{{ contact.LOCATION.href }}" target="_blank" rel="noopener noreferrer"><span>{{ contact.LOCATION.label }}</span><strong>{{ contact.LOCATION.value }}</strong></a></div>
    <div class="contact-links">{% for item in contact.CALLS_TO_ACTION %}<a href="{{ item.href }}"{% if item.href.startswith('http') %} target="_blank" rel="noopener noreferrer"{% endif %}><span>{{ item.label }}</span><strong>{{ item.value }}</strong><b aria-hidden="true">↗</b></a>{% endfor %}</div>
  </div>
</section>
