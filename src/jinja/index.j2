<!doctype html>
<html lang="{{ profile.SITE.language }}">
<head>
  {% include "meta.j2" %}
  <link rel="icon" href="assets/logo.png" type="image/png">
  <link rel="manifest" href="site.webmanifest">
  <link rel="stylesheet" href="assets/css/style.css">
  <script src="assets/js/script.js" defer></script>
</head>
<body>
  <a class="skip-link" href="#contenido">Saltar al contenido principal</a>
  {% include "navbar.j2" %}
  <main id="contenido">
    {% include "sidebar.j2" %}
    {% include "about.j2" %}
    {% include "projects.j2" %}
    {% include "technologies.j2" %}
    {% include "resume.j2" %}
    {% include "contact.j2" %}
  </main>
  <footer class="site-footer">
    <div class="container footer-layout">
      <p>© {{ build.year }} {{ profile.USER.name }}. Diseñado, desarrollado y mantenido por su autor.</p>
      <a href="{{ profile.SITE.repository }}" target="_blank" rel="noopener noreferrer">Código de este portafolio</a>
    </div>
  </footer>
</body>
</html>
