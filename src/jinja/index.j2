<!doctype html>
<html lang="{{ profile.SITE.language }}">
<head>
  {% include "meta.j2" %}
  <link rel="icon" href="assets/logo.png" type="image/png">
  <link rel="manifest" href="site.webmanifest">
  <link rel="preload" href="{{ profile.USER.avatar }}" as="image" fetchpriority="high">
  <link rel="stylesheet" href="assets/css/style.css">
  <script src="assets/js/script.js" type="module"></script>
</head>
<body>
  <canvas class="neural-canvas" data-neural-canvas aria-hidden="true"></canvas>
  <a class="skip-link" href="#contenido">Saltar al contenido</a>
  <div class="portfolio-shell">
    {% include "sidebar.j2" %}
    <div class="content-panel">
      {% include "navbar.j2" %}
      <main id="contenido" tabindex="-1">
        {% include "about.j2" %}
        {% include "resume.j2" %}
        {% include "projects.j2" %}
        {% include "technologies.j2" %}
        {% include "contact.j2" %}
      </main>
      <footer class="site-footer"><p>© {{ build.year }} {{ profile.USER.name }}.<small>Construido con Python · Jinja2 · YAML · GitHub Actions</small></p><a href="{{ profile.SITE.repository }}" target="_blank" rel="noopener noreferrer">Código del portafolio</a></footer>
    </div>
  </div>
</body>
</html>
