{% from "components/icons.j2" import icon, tech_chip with context %}
<section id="perfil" class="section page" data-page>
  <div class="container">
    <header class="section-heading">
      <p class="eyebrow"><span>01 /</span> {{ about.HEADER.eyebrow }}</p>
      <h2>Sobre mí</h2>
      <p>{{ about.HEADER.title }}</p>
    </header>
    <div class="profile-grid">
      <div class="prose">
        <p class="lead">{{ about.PRESENTATION.lead }}</p>
        {% for paragraph in about.PRESENTATION.paragraphs %}<p>{{ paragraph }}</p>{% endfor %}
        <div class="profile-cta"><a class="button-primary" href="#proyectos" data-page-shortcut>{{ icon(iconography.FUNCTIONAL.projects.icon, None, "button-icon") }}Ver proyectos</a><a class="button-secondary" href="{{ profile.SITE.repository }}" target="_blank" rel="noopener noreferrer">{{ icon(iconography.SOCIAL.github.icon, None, "button-icon", iconography.SOCIAL.github.color) }}Ver GitHub</a></div>
      </div>
      <dl class="metrics">
        {% set metric_icons = ["projects", "documents", "education", "briefcase"] %}
        {% for item in about.METRICS %}{% set metric_icon = iconography.FUNCTIONAL[metric_icons[loop.index0]] %}<div>{{ icon(metric_icon.icon, None, "metric-icon") }}<dt>{{ item.value }}</dt><dd>{{ item.label }}</dd></div>{% endfor %}
      </dl>
    </div>
    <h3 class="subheading">{{ about.FOCUS.label }}</h3>
    <div class="card-grid focus-grid">
      {% set focus_icons = ["canvas", "database", "realtime", "security"] %}{% for item in about.FOCUS["items"] %}{% set focus_icon = iconography.FUNCTIONAL[focus_icons[loop.index0]] %}<article class="info-card"><span class="card-number">0{{ loop.index }}</span>{{ icon(focus_icon.icon, None, "focus-icon") }}<h4>{{ item.title }}</h4><p>{{ item.description }}</p></article>{% endfor %}
    </div>
    <div class="two-column-block">
      <div>
        <h3 class="subheading">{{ about.STRENGTHS.label }}</h3>
        <ul class="check-list">{% for item in about.STRENGTHS["items"] %}<li>{{ item }}</li>{% endfor %}</ul>
      </div>
      <div>
        <h3 class="subheading">{{ about.STACK.label }}</h3>
        <div class="main-stack">{% for group in about.STACK.groups %}<h4>{{ group.title }}</h4><ul class="tags tech-chip-list">{% for item in group['items'] %}{{ tech_chip(item, iconography) }}{% endfor %}</ul>{% endfor %}<a href="#tecnologias" data-page-shortcut>Ver mapa técnico y evidencias →</a></div>
      </div>
    </div>
  </div>
</section>
