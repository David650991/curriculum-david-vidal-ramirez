<section id="perfil" class="section section-anchor">
  <div class="container">
    <header class="section-heading">
      <p class="eyebrow">{{ about.HEADER.eyebrow }}</p>
      <h2>{{ about.HEADER.title }}</h2>
    </header>
    <div class="profile-grid">
      <div class="prose">
        <p class="lead">{{ about.PRESENTATION.lead }}</p>
        {% for paragraph in about.PRESENTATION.paragraphs %}<p>{{ paragraph }}</p>{% endfor %}
      </div>
      <dl class="metrics">
        {% for item in about.METRICS %}<div><dt>{{ item.value }}</dt><dd>{{ item.label }}</dd></div>{% endfor %}
      </dl>
    </div>
    <h3 class="subheading">{{ about.FOCUS.label }}</h3>
    <div class="card-grid focus-grid">
      {% for item in about.FOCUS["items"] %}<article class="info-card"><span class="card-number">0{{ loop.index }}</span><h4>{{ item.title }}</h4><p>{{ item.description }}</p></article>{% endfor %}
    </div>
    <div class="two-column-block">
      <div>
        <h3 class="subheading">{{ about.STRENGTHS.label }}</h3>
        <ul class="check-list">{% for item in about.STRENGTHS["items"] %}<li>{{ item }}</li>{% endfor %}</ul>
      </div>
      <div>
        <h3 class="subheading">{{ about.STACK.label }}</h3>
        <div class="stack-groups">{% for group in about.STACK.groups %}<div><h4>{{ group.title }}</h4><ul class="tags">{% for item in group['items'] %}<li>{{ item }}</li>{% endfor %}</ul></div>{% endfor %}</div>
      </div>
    </div>
  </div>
</section>
