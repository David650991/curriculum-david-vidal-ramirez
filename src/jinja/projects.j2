{% from "components/icons.j2" import tech_chip with context %}
<section id="proyectos" class="section page" data-page hidden>
  <div class="container">
    <header class="section-heading">
      <p class="eyebrow"><span>03 /</span> {{ projects.HEADER.eyebrow }}</p>
      <h2>{{ projects.HEADER.title }}</h2>
      <p>{{ projects.HEADER.description }}</p>
    </header>
    <div class="project-filters" role="group" aria-label="Filtrar proyectos">
      {% for category in ["Todos", "Aplicaciones web", "Backend", "Tiempo real", "Visión computacional", "Seguridad", "Automatización", "Web institucional"] %}<button type="button" data-project-filter="{{ category }}"{% if loop.first %} class="is-active" aria-pressed="true"{% else %} aria-pressed="false"{% endif %}>{{ category }}</button>{% endfor %}
    </div>
    <div class="project-grid">
      {% for item in projects.PROJECTS | sort(attribute="priority") %}
      <article class="project-card{% if item.featured %} project-featured{% endif %}" data-project data-categories="{{ item.categories | join('|') }}">
        <div class="project-visual visual-{{ loop.index }}">
          {% if item.image is defined %}<img src="{{ item.image }}" alt="{% if item.image_label is defined %}{{ item.image_label }} de {{ item.title }}{% else %}Vista del proyecto {{ item.title }}{% endif %}" width="{{ item.image_width | default(1366) }}" height="{{ item.image_height | default(1136) }}" loading="lazy" decoding="async">{% if item.image_label is defined %}<small class="project-image-label">{{ item.image_label }}</small>{% endif %}{% else %}<span aria-hidden="true">{{ item.monogram }}</span>{% endif %}
        </div>
        <div class="project-content">
          <div class="project-meta"><span>{{ item.category }}</span><strong data-status="{{ item.status_kind }}">{{ item.status }}</strong></div>
          <h3>{{ item.title }}</h3>
          <p>{{ item.summary }}</p>
          <ul class="tags project-stack-preview tech-chip-list">{% for technology in item.stack[:5] %}{{ tech_chip(technology, iconography) }}{% endfor %}</ul>
          <details class="project-case">
            <summary>Ver caso técnico <span aria-hidden="true">＋</span></summary>
            <div class="project-case-content">
              <section class="case-section"><h4>Problema</h4><p>{{ item.problem }}</p></section>
              <section class="case-section"><h4>Solución</h4><p>{{ item.operation }}</p></section>
              <dl class="project-details">
                <div><dt>Mi aportación</dt><dd>{{ item.contribution }}</dd></div>
                <div><dt>Retos y alcance actual</dt><dd>{{ item.scope }}</dd></div>
              </dl>
              <h4>Arquitectura</h4><div class="architecture-flow" aria-label="Arquitectura de {{ item.title }}">{% for step in item.architecture %}<span>{{ step }}</span>{% if not loop.last %}<b aria-hidden="true">→</b>{% endif %}{% endfor %}</div>
              <h4>Funciones</h4><ul class="project-highlights">{% for highlight in item.highlights %}<li>{{ highlight }}</li>{% endfor %}</ul>
              <p class="project-aspects"><strong>Aspectos técnicos trabajados:</strong> {{ item.aspects }}</p>
              <h4>Stack completo</h4><ul class="tags tech-chip-list">{% for technology in item.stack %}{{ tech_chip(technology, iconography) }}{% endfor %}</ul>
              {% if item.note is defined %}<p class="project-note">{{ item.note }}</p>{% endif %}
              {% if item.demo_url or item.repository_url %}<div class="project-links">{% if item.demo_url %}<a href="{{ item.demo_url }}" target="_blank" rel="noopener noreferrer">Ver aplicación ↗</a>{% endif %}{% if item.repository_url %}<a href="{{ item.repository_url }}" target="_blank" rel="noopener noreferrer">Ver repositorio ↗</a>{% endif %}</div>{% endif %}
            </div>
          </details>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>
