<section id="proyectos" class="section section-alt section-anchor">
  <div class="container">
    <header class="section-heading">
      <p class="eyebrow">{{ projects.HEADER.eyebrow }}</p>
      <h2>{{ projects.HEADER.title }}</h2>
      <p>{{ projects.HEADER.description }}</p>
    </header>
    <div class="project-grid">
      {% for item in projects.PROJECTS %}
      <article class="project-card{% if item.featured %} project-featured{% endif %}">
        <div class="project-visual visual-{{ loop.index }}">
          {% if item.image is defined %}<img src="{{ item.image }}" alt="Vista del proyecto {{ item.title }}" width="1366" height="1136" loading="lazy" decoding="async">{% else %}<span aria-hidden="true">{{ item.monogram }}</span>{% endif %}
        </div>
        <div class="project-content">
          <div class="project-meta"><span>{{ item.category }}</span><strong>{{ item.status }}</strong></div>
          <h3>{{ item.title }}</h3>
          <p>{{ item.summary }}</p>
          <ul class="project-highlights">{% for highlight in item.highlights %}<li>{{ highlight }}</li>{% endfor %}</ul>
          <ul class="tags">{% for technology in item.stack %}<li>{{ technology }}</li>{% endfor %}</ul>
          {% if item.note is defined %}<p class="project-note">{{ item.note }}</p>{% endif %}
          <div class="project-links">
            {% if item.demo_url %}<a href="{{ item.demo_url }}" target="_blank" rel="noopener noreferrer">Ver aplicación <span aria-hidden="true">↗</span></a>{% endif %}
            {% if item.repository_url %}<a href="{{ item.repository_url }}" target="_blank" rel="noopener noreferrer">Ver repositorio <span aria-hidden="true">↗</span></a>{% endif %}
          </div>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>
