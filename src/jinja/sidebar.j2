<section id="inicio" class="hero section-anchor">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">Creador y desarrollador de soluciones digitales</p>
      <h1>{{ profile.USER.name }}</h1>
      <p class="hero-role">{{ profile.USER.role }}</p>
      <p class="hero-summary">Construyo aplicaciones que convierten procesos manuales y necesidades institucionales en experiencias web funcionales, documentadas y desplegables.</p>
      <div class="hero-actions">
        <a class="button button-primary" href="#proyectos">Explorar proyectos</a>
        <a class="button button-secondary" href="mailto:{{ profile.USER.email }}">Contactarme</a>
      </div>
      <p class="availability"><span aria-hidden="true"></span>{{ profile.USER.availability }}</p>
    </div>
    <div class="portrait-panel">
      <div class="portrait-glow" aria-hidden="true"></div>
      <img src="{{ profile.USER.avatar }}" alt="Retrato profesional de {{ profile.USER.name }}" width="472" height="528" fetchpriority="high">
      <div class="portrait-caption"><strong>3.er semestre</strong><span>Ingeniería en Sistemas Computacionales · TecNM</span></div>
    </div>
  </div>
</section>
