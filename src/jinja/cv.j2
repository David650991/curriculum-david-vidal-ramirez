<!doctype html><html lang="es-MX"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>CV de {{ profile.USER.name }}</title><style>body{max-width:850px;margin:32px auto;padding:0 24px;font:15px/1.45 Arial,sans-serif;color:#111}h1{margin-bottom:4px}h2{margin-top:28px;border-bottom:1px solid #999;font-size:18px}h3{margin-bottom:2px;font-size:15px}p,ul{margin-top:5px}.meta{color:#333}.project{break-inside:avoid}@media print{body{margin:0;max-width:none}a{color:#111;text-decoration:none}}</style></head><body><header><h1>{{ profile.USER.name }}</h1><strong>Desarrollador de Software</strong><p class="meta">{{ profile.USER.academic_status }}<br>{{ profile.USER.location }} · {{ profile.USER.email }} · {{ profile.USER.phone_display }}</p></header><main><h2>Perfil profesional</h2><p>{{ about.PRESENTATION.lead }} {{ about.PRESENTATION.paragraphs | join(' ') }}</p><h2>Formación</h2>{% for item in resume.EDUCATION['items'] %}<h3>{{ item.institution }}</h3><p>{{ item.period }} · {{ item.description }}</p>{% endfor %}<h2>Experiencia reciente</h2>{% for item in resume.EXPERIENCE['items'] %}<article><h3>{{ item.position }} — {{ item.organization }}</h3><p>{{ item.period }}</p><ul>{% for bullet in item.bullets %}<li>{{ bullet }}</li>{% endfor %}</ul></article>{% endfor %}<h2>Proyectos destacados</h2>{% for item in (projects.PROJECTS | sort(attribute='priority'))[:5] %}<article class="project"><h3>{{ item.title }} — {{ item.status }}</h3><p>{{ item.summary }}</p><p><strong>Tecnologías:</strong> {{ item.stack | join(', ') }}</p></article>{% endfor %}<h2>Competencias técnicas</h2>{% for group in about.STACK.groups %}<p><strong>{{ group.title }}:</strong> {{ group['items'] | join(', ') }}</p>{% endfor %}<h2>Idiomas</h2>{% for item in resume.LANGUAGES['items'] %}<p>{{ item.language }} — {{ item.level }}</p>{% endfor %}</main></body></html>
